*.iml
.gradle*/
.scratch/
.workbuddy/
local.properties
.idea/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
# 运行时快照不入库（CI 构建时注入）
app/src/main/assets/runtime.zip
# ABI 戳是构建产物：入库会让 CI 的 prepareRuntime 命中 skip 分支，
# 绕过 PTC 补丁校验与去重（审查 P1，v1.4.16）
app/src/main/assets/runtime/.abi
# 签名密钥绝不入库（release 与 debug 同一套规矩：只存在于 CI secrets 与本地磁盘）
keystore/
*.keystore
*.jks
# 整个目录都不入库，**包括**证书指纹：期望值统一走 CI 变量 DEBUG_CERT_SHA256，
# 仓库里不保留任何与该 key 同源的文件（少一个需要同步的地方，也不会有人拿旧指纹当准）。
# ⚠️ 不要写成 `!debug-signing/xxx`：解禁单个文件时极易顺手解禁目录，而目录里躺着
#    dsh-debug.properties（口令）与 dsh-debug.keystore.base64（私钥本体）。
debug-signing/*
# 扩展闭包审计缓存（scripts/audit-extension-closures.py）
_debcheck/

# 工具产生的会话/钩子状态（非项目内容）
.mimosa/
# WorkBuddy 的工作记忆（设备/构建踩坑记录，同 .mimosa/ 性质，不入库）
.workbuddy/

# Python 字节码缓存
__pycache__/
*.pyc

# patch-curl-wrapper.py / dedupe-runtime.py 的自动备份（体积大，不入库）
app/src/main/assets/*.bak
app/src/main/assets/*.tmp

# 本地 runtime 快照备份（126MB × N，不入库；assets 里的备份会被打进 APK）
_runtime_bak/

# 本地临时测试产物（真机会话样本等）
_*.zstd
_*.png
_probe_*
scripts/probes/testsite/*.apk
scene_memory.json
dist/
_release_*.py
node_modules/

# dev probe artifacts
scripts/probes/_parts/
scripts/probes/*.bin


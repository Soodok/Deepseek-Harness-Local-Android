# 运行时快照不入库（CI 构建时注入）
app/src/main/assets/runtime.zip
# ABI 戳是构建产物：入库会让 CI 的 prepareRuntime 命中 skip 分支，
# 绕过 PTC 补丁校验与去重（审查 P1，v1.4.16）
app/src/main/assets/runtime/.abi
# 签名密钥绝不入库
keystore/
*.keystore
*.jks
# 扩展闭包审计缓存（scripts/audit-extension-closures.py）
_debcheck/

# 工具产生的会话/钩子状态（非项目内容）
.mimosa/

# Python 字节码缓存
__pycache__/
*.pyc

# patch-curl-wrapper.py / dedupe-runtime.py 的自动备份（体积大，不入库）
app/src/main/assets/*.bak
app/src/main/assets/*.tmp

# 本地 runtime 快照备份（126MB × N，不入库；assets 里的备份会被打进 APK）
_runtime_bak/


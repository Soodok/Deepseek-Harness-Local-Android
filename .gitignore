*.iml
.gradle*/
.scratch/
.workbuddy/
local.properties
.idea/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
# 运行时快照不入库（CI 构建时注入）
app/src/main/assets/runtime.zip
# ABI 戳是构建产物：入库会让 CI 的 prepareRuntime 命中 skip 分支，
# 绕过 PTC 补丁校验与去重（审查 P1，v1.4.16）
app/src/main/assets/runtime/.abi
# 签名密钥绝不入库
keystore/
*.keystore
*.jks
# 例外：固定 debug 签名材料（唯一入库的密钥，见 docs/RELEASE.md / docs/AUTO_UPDATE_PLAN.md §13）
# `*.keystore` 全局忽略，所以必须逐文件否定；release key 仍在 keystore/（上面整目录忽略）。
# ⚠️ 不要把 debug key 放进 keystore/ 来绕开这些规则 —— 一旦 `!keystore/` 解禁目录，
#    同目录下的 dsh-release.keystore.base64 / release.properties 会立刻变成可跟踪。
!debug-signing/
!debug-signing/dsh-debug.keystore
!debug-signing/dsh-debug.properties
!debug-signing/dsh-debug.fingerprint.txt
# 扩展闭包审计缓存（scripts/audit-extension-closures.py）
_debcheck/

# 工具产生的会话/钩子状态（非项目内容）
.mimosa/
# WorkBuddy 的工作记忆（设备/构建踩坑记录，同 .mimosa/ 性质，不入库）
.workbuddy/

# Python 字节码缓存
__pycache__/
*.pyc

# patch-curl-wrapper.py / dedupe-runtime.py 的自动备份（体积大，不入库）
app/src/main/assets/*.bak
app/src/main/assets/*.tmp

# 本地 runtime 快照备份（126MB × N，不入库；assets 里的备份会被打进 APK）
_runtime_bak/


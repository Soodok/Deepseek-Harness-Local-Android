<?xml version="1.0" encoding="utf-8"?>
<!--
  灵动岛胶囊（v1.5.6 悬浮质感）。

  ## ★暗色主题上的悬浮感 ≠ 投影
  我先做错了：在深色背景上叠深色投影。深色叠深色等于没有 —— 实测下来只在
  胶囊正下方留了一条脏暗带，不是「浮起来」，而是「旁边有污渍」。

  暗色主题里悬浮感的正确来源是**边缘提亮**：浮起来的表面接收更多环境光，
  所以它比周围亮。Material Design 的 elevation 在深色主题下也是这个逻辑 ——
  层级越高 surface 越浅（surface tint），不是阴影越深。

  这一版：上缘一圈浅灰高光 + 一圈浅灰外描边，让胶囊从背景里「切」出来。

  ## 为什么用渐变而不是硬编码偏移
  第一版用 `android:top="43dp"` 定位边缘线，依赖容器正好 44dp —— 布局一改
  就错位，而且不报错。渐变依赖的是**相对高度**（0% → 30%），容器多高都对。

  ## 三层 layer-list 的顺序
  `<item>` 按文档顺序绘制，**后者在上**。这个顺序踩过坑：把高光写在第一层
  会被后面不透明的底色整个盖住，界面等于没有高光，编译运行都不报错。
  所以：底色 → 上缘高光 → 外描边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 第 1 层（先画=最底）：不透明岛底。悬浮物该是实的，透了会「陷」进背景 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/island_bg" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 第 2 层：上缘浅灰高光。渐变只占上部约 35%，下面完全透明 —— -->
    <!-- 读起来是「顶面受光」，而不是整块玻璃的斜向渐变（那个方案已被否掉） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:centerY="0.35"
                android:startColor="@color/island_edge_light"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 第 3 层（最后画=最顶）：浅灰外描边，把胶囊从背景里切出来 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/island_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
  已安装态胶囊（填充版）—— 与 bg_ghost_btn 成对。

  为什么已装要用填充而不是同一个描边换色：如果两者都是描边、只换描边色，
  在暗色 UI 上「浅蓝描边」与「浅绿描边」的视觉重量几乎一样，扫一眼分不出
  「哪个装好了」。填充块明显更重，状态差异靠重量 + 颜色双重编码。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/success_soft" />
            <stroke android:width="1.5dp" android:color="@color/success" />
            <corners android:radius="@dimen/md3_button_radius" />
        </shape>
    </item>
</layer-list>

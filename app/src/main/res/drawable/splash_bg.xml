<?xml version="1.0" encoding="utf-8"?>
<!--
  启动页背景（v1.6.19）。

  两层：
    1. 竖向渐变（270°）—— 顶部略亮、底部更深，视线自然落在上三分之一；
    2. 偏上的径向光晕 —— 极低不透明度，只负责把环的位置「托」起来。

  为什么这次去掉顶部高光那一条：上一版三层叠起来在深色下边缘出现了一道
  可见的分界（渐变角度不同），用户看着像「屏幕脏了」。两层就够。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/splash_start"
                android:centerColor="@color/splash_mid"
                android:endColor="@color/splash_end" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.22"
                android:gradientRadius="62%p"
                android:startColor="@color/splash_glow"
                android:endColor="#00000000" />
        </shape>
    </item>

</layer-list>

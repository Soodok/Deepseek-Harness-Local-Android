<?xml version="1.0" encoding="utf-8"?>
<!-- v1.5.6：回到旧卡片身份 —— 实心 surface + 1dp 细描边 + 18dp 圆角。
     MD3 原版是 surfaceVariant 填充、无描边、20dp，看起来"发白、发飘"，
     与旧界面（bg_card）的"深色面板 + 细线"观感差得远。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/dshSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/dshStroke" />
    <corners android:radius="18dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃质感卡片（v1.5.5 视觉统一）。

  ## 为什么是「多层渐变」而不是一条 <solid>
  平面卡片的观感问题不是颜色不好看，而是**没有光源方向**：整块同色 + 一条描边，
  眼睛读不出「这个东西浮在背景上」。真实玻璃的观感来自三件事：
    1. 顶部有一条更亮的高光（光从上面来）
    2. 边缘有一圈内描边（厚度感）
    3. 下方有柔和投影（离背景的远近）

  Android 的 <shape> 只能给一条 solid + 一条 stroke，做不出「上下不同亮」。
  所以用 layer-list 叠三层：高光渐变（上亮下透）+ 底色 + 内描边。

  ## 不能做成真模糊
  `FLAG_BLUR_BEHIND` 是 API 31+，本项目 minSdk 26。低版本上「玻璃」只能做到
  「半透明 + 高光 + 投影」，做不到背后内容被糊开。这是系统限制，不是实现偷懒。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 第 2 层：底色。surface_glass 是半透明色，能透出背后的界面 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_glass" />
            <corners android:radius="@dimen/md3_card_radius" />
        </shape>
    </item>
    <!-- 第 2 层：顶部高光（叠在底色之上）。白色从上往下 12% → 2%，模拟光从上方照下来 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/md3_card_radius" />
        </shape>
    </item>
    <!-- 第 3 层（最后画=最顶）：内描边（厚度感）。画在最上面才不会被底色盖掉 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/stroke_glass" />
            <corners android:radius="@dimen/md3_card_radius" />
        </shape>
    </item>
</layer-list>

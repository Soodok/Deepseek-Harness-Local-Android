<?xml version="1.0" encoding="utf-8"?>
<!-- 内缩 4dp 的描边胶囊（停用）：与 solid / tonal 版同尺寸，避免切换状态时按钮尺寸跳动。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="?attr/dshTextSecondary" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView 全屏垫底：半透明工具栏悬浮其上（网页内容透出，浏览器质感） -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 安装/启动进度条：Installing 显示真实解压百分比，Starting 转不确定动画 -->
    <ProgressBar
        android:id="@+id/installProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/stroke"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- 灵动岛（收起态）：纯黑悬浮胶囊，可拖到屏幕边缘任意位置，点它展开工具栏 -->
    <LinearLayout
        android:id="@+id/handleBar"
        android:layout_width="88dp"
        android:layout_height="30dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_dynamic_island"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <View
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:background="#FF3A3A3C" />
        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_island_dot" />
    </LinearLayout>

    <!-- 灵动岛（展开态）：工具栏收进悬浮黑岛；宽度撑满留边距，竖屏也不裁切按钮 -->
    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_dynamic_island"
        android:elevation="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 预览模式返回按钮：仅当 WebView 位于非引擎端口的回环页面时显示 -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_back"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_restart"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 日志查看器入口：engine.log / boot.log 尾部（排查引擎重启等问题） -->
        <TextView
            android:id="@+id/btnLog"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_log"
            android:textColor="#FF9AA5B4"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 原生终端入口：跳转独立终端页（真 PTY，自带 bash） -->
        <TextView
            android:id="@+id/btnTerminal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_terminal"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 隐藏工具栏：一键让网页全屏（点顶部小把手唤回） -->
        <TextView
            android:id="@+id/btnHide"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_hide"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 设置入口：齿轮图标（跳转独立设置页） -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_settings"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <!-- ==================== 启动动画（v1.3.1） ====================
         冷启动时运行时解压 + 引擎启动需要时间，之前这段时间是一块空黑屏（用户反馈）。
         这里用一层品牌遮罩盖住：logo 淡入 + 轻微呼吸、真实解压百分比、
         状态文案随引擎阶段变化；WebView 首屏加载完成后淡出。
         clickable/focusable：遮罩期间吞掉误触，避免用户点到下面还没就绪的界面。 -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/splash_bg"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="22dp"
            android:background="@drawable/splash_card">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:padding="18dp"
                android:src="@drawable/ic_launcher"
                android:background="@drawable/splash_logo_bg"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/splash_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/splash_preparing"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:fontFamily="monospace"
                tools:text="3.2s" />

            <ProgressBar
                android:id="@+id/splashProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="240dp"
                android:layout_height="6dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/stroke" />

            <TextView
                android:id="@+id/splashDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"
                tools:text="48,203 / 50,405 files" />

            <TextView
                android:id="@+id/splashToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/splash_show_steps"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:background="@drawable/splash_pill" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/splash_hint"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/splashStepsScroll"
            android:layout_width="340dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/splashSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>

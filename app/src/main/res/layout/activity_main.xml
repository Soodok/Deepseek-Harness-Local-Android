<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView 全屏垫底：半透明工具栏悬浮其上（网页内容透出，浏览器质感） -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 工具栏隐藏后的顶部把手：轻点唤回 -->
    <View
        android:id="@+id/handleBar"
        android:layout_width="72dp"
        android:layout_height="5dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="3dp"
        android:background="#3D7DD3FC"
        android:visibility="gone" />

    <!-- 工具栏：70% 半透明悬浮层；点文字空白区隐藏，点把手唤回 -->
    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#B31A2028"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:textColor="#FF9CA3AF"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 预览模式返回按钮：仅当 WebView 位于非引擎端口的回环页面时显示 -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_back"
            android:textColor="#FF6EE7B7"
            android:textSize="13sp"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_restart"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnPreview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_preview"
            android:textColor="#FF6EE7B7"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="2dp"
            android:text="@string/btn_more"
            android:textColor="#FF9CA3AF"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</FrameLayout>

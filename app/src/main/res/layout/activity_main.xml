<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView 全屏垫底：半透明工具栏悬浮其上（网页内容透出，浏览器质感） -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 安装/启动进度条：Installing 显示真实解压百分比，Starting 转不确定动画 -->
    <ProgressBar
        android:id="@+id/installProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/stroke"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- 灵动岛（收起态）：纯黑正圆 + 外围小光圈，直径与展开态高度一致，
         点它唤回工具栏。早期版本是宽胶囊 + 内部横条，收起后横向占位太宽、
         还会压到状态文字，故改为正圆。 -->
    <LinearLayout
        android:id="@+id/handleBar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_dynamic_island_dot"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_island_core_dot" />
    </LinearLayout>

    <!-- 灵动岛（展开态）：工具栏收进悬浮黑岛；宽度撑满留边距，竖屏也不裁切按钮 -->
    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_dynamic_island"
        android:elevation="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:textColor="@color/island_text"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 预览模式返回：仅当 WebView 位于非引擎端口的回环页面时显示 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/island_success"
            android:visibility="gone"
            android:contentDescription="@string/btn_back"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 重启引擎 -->
        <ImageView
            android:id="@+id/btnRestart"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_restart"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_restart"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 原生终端入口：跳转独立终端页（真 PTY，自带 bash） -->
        <ImageView
            android:id="@+id/btnTerminal"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_terminal"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_terminal"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 隐藏工具栏：一键让网页全屏（点顶部小把手唤回） -->
        <ImageView
            android:id="@+id/btnHide"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_chevron"
            android:tint="@color/island_text"
            android:contentDescription="@string/btn_hide"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 设置入口：齿轮图标（跳转独立设置页） -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/island_text"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <!-- ==================== 启动动画（v1.3.1） ====================
         冷启动时运行时解压 + 引擎启动需要时间，之前这段时间是一块空黑屏（用户反馈）。
         这里用一层品牌遮罩盖住：logo 淡入 + 轻微呼吸、真实解压百分比、
         状态文案随引擎阶段变化；WebView 首屏加载完成后淡出。
         clickable/focusable：遮罩期间吞掉误触，避免用户点到下面还没就绪的界面。 -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/splash_bg"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 卡片整体可滚动（v1.4.30 修复）：展开加载步骤后卡片会变高，
             小屏 / 横屏下若超出可用高度，由这层兜底滚动，避免卡片被居中裁掉上下两端。 -->
        <ScrollView
            android:id="@+id/splashCardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="22dp"
            android:background="@drawable/splash_card">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:padding="18dp"
                android:src="@drawable/ic_launcher"
                android:background="@drawable/splash_logo_bg"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/splash_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/splash_preparing"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:fontFamily="monospace"
                tools:text="3.2s" />

            <ProgressBar
                android:id="@+id/splashProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="240dp"
                android:layout_height="6dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/stroke" />

            <TextView
                android:id="@+id/splashDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"
                tools:text="48,203 / 50,405 files" />

            <TextView
                android:id="@+id/splashToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/splash_show_steps"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:background="@drawable/splash_pill" />

            <!-- 加载步骤面板（v1.4.30 修复）：原先它是卡片的兄弟节点，展开后日志裸挂在
                 卡片外的页面背景上，看起来像卡片"破了洞"。现在收进卡片内部、与卡片同宽，
                 上方加分隔线明确层级；高度由代码按内容动态限制（见 applyStepsViewport）。 -->
            <LinearLayout
                android:id="@+id/splashStepsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <ScrollView
                    android:id="@+id/splashStepsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/splashSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp" />
                </ScrollView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/splash_hint"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>

        </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

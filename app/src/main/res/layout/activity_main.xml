<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView 全屏垫底：半透明工具栏悬浮其上（网页内容透出，浏览器质感） -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 安装/启动进度条：Installing 显示真实解压百分比，Starting 转不确定动画 -->
    <ProgressBar
        android:id="@+id/installProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:max="10000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/stroke"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- 灵动岛（收起态）：纯黑正圆 + 外围小光圈，直径与展开态高度一致，
         点它唤回工具栏。早期版本是宽胶囊 + 内部横条，收起后横向占位太宽、
         还会压到状态文字，故改为正圆。 -->
    <LinearLayout
        android:id="@+id/handleBar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_dynamic_island_dot"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_island_core_dot" />
    </LinearLayout>

    <!-- 灵动岛（展开态）：工具栏收进悬浮胶囊；宽度撑满留边距，竖屏也不裁切按钮。
         外层 FrameLayout 是贴纸图层：用户贴的图叠在胶囊上方，且与胶囊同进同退
         （位置/尺寸都由这个容器决定），不需要在贴纸自己身上再算坐标。 -->
    <FrameLayout
        android:id="@+id/statusBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:elevation="10dp">

    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_dynamic_island"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:textColor="@color/island_text"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 预览模式返回：仅当 WebView 位于非引擎端口的回环页面时显示 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/island_success"
            android:visibility="gone"
            android:contentDescription="@string/btn_back"
            android:background="@drawable/bg_island_btn" />

        <!-- 重启引擎 -->
        <ImageView
            android:id="@+id/btnRestart"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_restart"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_restart"
            android:background="@drawable/bg_island_btn" />

        <!-- 原生终端入口：跳转独立终端页（真 PTY，自带 bash） -->
        <ImageView
            android:id="@+id/btnTerminal"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_terminal"
            android:tint="@color/island_accent"
            android:contentDescription="@string/btn_terminal"
            android:background="@drawable/bg_island_btn" />

        <!-- 隐藏工具栏：一键让网页全屏（点顶部小把手唤回） -->
        <ImageView
            android:id="@+id/btnHide"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_chevron"
            android:tint="@color/island_text"
            android:contentDescription="@string/btn_hide"
            android:background="@drawable/bg_island_btn" />

        <!-- 设置入口：齿轮图标（跳转独立设置页） -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/island_text"
            android:background="@drawable/bg_island_btn"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>
    </FrameLayout>

    <!-- ==================== 启动动画（v1.3.1） ====================
         冷启动时运行时解压 + 引擎启动需要时间，之前这段时间是一块空黑屏（用户反馈）。
         这里用一层品牌遮罩盖住：logo 淡入 + 轻微呼吸、真实解压百分比、
         状态文案随引擎阶段变化；WebView 首屏加载完成后淡出。
         clickable/focusable：遮罩期间吞掉误触，避免用户点到下面还没就绪的界面。 -->
        <include layout="@layout/view_boot_splash" />
</FrameLayout>

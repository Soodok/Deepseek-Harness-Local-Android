<?xml version="1.0" encoding="utf-8"?>
<!-- 首次启动引导（v1.7.0 重做）：七步向导，手机与平板两种形态

     ## 形态分派
       · < 600dp（手机竖屏）：单列 + 顶部「≡ 全部步骤」抽屉；
       · >= 600dp（平板 / 横屏）：左侧 206dp 步骤轨常驻，右侧内容区两列可选。

     两条形态共用同一份 steps 定义（见 OnboardingActivity），只是外层容器不同，
     不写两份引导逻辑。

     ## 为什么预览用自绘控件
       方向、明暗这些选项的后果是**布局形态**，不是文字。用 LayoutPreviewView
       自绘一块屏幕（圆角底 + 标题条 + 占位线），切形态只改一个布尔值。

     ## 完成页保持原样
       用户明确要求保留（v1.5.x 的光晕 + 白鲸 + 呼吸循环），这里不动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <!-- ===== 平板 / 横屏：常驻步骤轨（代码里按宽度决定是否显示）===== -->
        <LinearLayout
            android:id="@+id/sideRail"
            android:layout_width="206dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingBottom="10dp"
                android:text="@string/ob_wizard_rail_title"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/railSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <!-- ===== 顶部：进度条 + 步骤文字 ===== -->
            <LinearLayout
                android:id="@+id/topBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/stepProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:max="7"
                        android:progress="1"
                        android:progressBackgroundTint="@color/stroke"
                        android:progressTint="@color/accent" />

                    <TextView
                        android:id="@+id/btnSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_ob_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="30dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/ob_wizard_steps_open"
                        android:textColor="@color/accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtStepHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== 内容区：七页叠放，只显示当前页 ===== -->
            <FrameLayout
                android:id="@+id/pageHost"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 1. 语言 -->
                <ScrollView
                    android:id="@+id/pageLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_wizard_language_title"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_language_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/langContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- 2. 显示方向（带真机画面预览） -->
                <ScrollView
                    android:id="@+id/pageOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_wizard_orientation_title"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_orientation_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- 预览框：切方向时真实变形，不是示意图片 -->
                        <FrameLayout
                            android:id="@+id/orientPreviewBox"
                            android:layout_width="match_parent"
                            android:layout_height="176dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_ob_preview"
                            android:padding="12dp">

                            <app.dsh.mobile.ui.LayoutPreviewView
                                android:id="@+id/orientPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/orientPreviewLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/orientContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:id="@+id/orientHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="14dp" />
                    </LinearLayout>
                </ScrollView>

                <!-- 3. 外观主题（带明暗预览） -->
                <ScrollView
                    android:id="@+id/pageTheme"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_wizard_theme_title"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_theme_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- 明暗对照：同一块界面画两遍，不用切主题就能看出差别 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:id="@+id/themePreviewBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="150dp"
                                    android:background="@drawable/bg_ob_preview"
                                    android:padding="10dp">

                                    <app.dsh.mobile.ui.LayoutPreviewView
                                        android:id="@+id/themePreview"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/themePreviewLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:id="@+id/themePreviewBox2"
                                    android:layout_width="match_parent"
                                    android:layout_height="150dp"
                                    android:background="@drawable/bg_ob_preview"
                                    android:padding="10dp">

                                    <app.dsh.mobile.ui.LayoutPreviewView
                                        android:id="@+id/themePreview2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/themePreviewLabel2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/themeContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- 4. 配色方案（带实时预览） -->
                <ScrollView
                    android:id="@+id/pageAccent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_wizard_accent_title"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_accent_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- 实时预览：选色后这里立刻重涂（与按钮/进度条同色，证明生效） -->
                        <LinearLayout
                            android:id="@+id/accentPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="14dp" />

                        <LinearLayout
                            android:id="@+id/accentContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- 5. 屏幕与布局（新增：缩放 / 设置页布局 / 沉浸式） -->
                <ScrollView
                    android:id="@+id/pageScreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_wizard_screen_title"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_screen_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/ob_wizard_screen_scale"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:id="@+id/scaleContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/ob_wizard_screen_layout"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:id="@+id/layoutModeContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/ob_wizard_screen_immersive"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:id="@+id/immersiveContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- 6. 运行模式与能力（模式单选 + 能力多选） -->
                <ScrollView
                    android:id="@+id/pagePriv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_wizard_priv_title"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_priv_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/privContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical" />

                        <!-- 能力检测结果（Root 用 su 实测；Shizuku 用 binder ping） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/capRoot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/capShizuku"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 能力开关区 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ob_wizard_cap_title"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnCapRecommend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_ob_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:minHeight="32dp"
                                android:paddingHorizontal="14dp"
                                android:text="@string/ob_wizard_cap_recommend"
                                android:textColor="@color/accent"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ob_wizard_cap_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />

                        <LinearLayout
                            android:id="@+id/capabilityContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </ScrollView>

                <!-- 7. 完成（设计保持 v1.5.x：光晕 + 白鲸 + 呼吸循环）。
                     2026-11-11 只修了两处让这个设计没按原意呈现的缺陷：光晕半径按 px
                     解析（见 bg_onboarding_glow.xml）、呼吸只跑一个来回。
                     clipChildren=false：呼吸放大到 1.12 倍会超出下面 200dp 的
                     FrameLayout，父级裁剪会把光晕切出一圈方边。 -->
                <LinearLayout
                    android:id="@+id/pageDone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="32dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_marginTop="24dp">

                        <View
                            android:id="@+id/doneGlow"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_onboarding_glow" />

                        <ImageView
                            android:id="@+id/doneLogo"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_launcher_foreground"
                            android:tint="@color/onboarding_logo_tint" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ob_wizard_done_title"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ob_wizard_done_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <!-- v1.7.10：运行环境预取状态。用户还在挑语言/主题时，后台已在解压；
                         这里显示「正在解压 42% / 已就绪 / 准备未完成」，完成页不再是空半屏。 -->
                    <TextView
                        android:id="@+id/txtDoneRuntime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/pbDoneRuntime"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="180dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
                <!-- ===== 底部按钮 =====
                     放在 MaxWidthLinearLayout 内部（而不是根容器末尾）：这样平板上
                     它会自动落在右侧内容列下方、与卡片同宽，不会横跨左侧步骤栏。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp">

                    <Button
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_btn_outline_ripple"
                        android:minWidth="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/ob_wizard_back"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_accent_ripple"
                        android:text="@string/ob_wizard_next"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
        </app.dsh.mobile.MaxWidthLinearLayout>
    </LinearLayout>

    <!-- ===== 手机形态：步骤抽屉（覆盖层）===== -->
    <FrameLayout
        android:id="@+id/stepsDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay" />

        <LinearLayout
            android:id="@+id/drawerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_dialog_rounded"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_wizard_rail_title"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/drawerSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

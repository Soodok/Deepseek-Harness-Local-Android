<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <!-- v1.4.18：平板横屏下限宽居中，引导卡片不被拉满整屏 -->
    <app.dsh.mobile.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ob_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ob_lang_label"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/cardLangDe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtLangDe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_de"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/cardLangZh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtLangZh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_zh"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/cardLangPt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtLangPt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_pt"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/cardLangEn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtLangEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_en"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>



        <!-- 默认显示方向 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_orientation_label"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ob_orientation_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- 竖屏演示卡（v1.2.120：三卡横排，尺寸相应收敛） -->
            <LinearLayout
                android:id="@+id/cardPortrait"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_dialog_rounded"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="48dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_demo_portrait" />

                <TextView
                    android:id="@+id/txtPortrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ob_orient_portrait"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- 横屏演示卡 -->
            <LinearLayout
                android:id="@+id/cardLandscape"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_dialog_rounded"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_demo_landscape" />

                <TextView
                    android:id="@+id/txtLandscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ob_orient_landscape"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- 自动演示卡（v1.2.120 新增）：跟随设备旋转，不锁定方向 -->
            <LinearLayout
                android:id="@+id/cardAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_dialog_rounded"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_demo_auto" />

                <TextView
                    android:id="@+id/txtAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ob_orient_auto"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 外观主题：起始页三选一，设置页复用同一偏好 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_theme_label"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ob_theme_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/cardThemeDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_dialog_rounded"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtThemeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/cardThemeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_dialog_rounded"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtThemeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/cardThemeSystem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_dialog_rounded"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtThemeSystem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 运行权限模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_priv_label"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ob_priv_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <RadioGroup
            android:id="@+id/privGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/privNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_priv_normal"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_priv_normal_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="32dp" />

            <RadioButton
                android:id="@+id/privShizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_priv_shizuku"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_priv_shizuku_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="32dp" />

            <RadioButton
                android:id="@+id/privRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_priv_root"
                android:textColor="@color/danger"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/rootHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ob_priv_root_desc"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:layout_marginStart="32dp" />
        </RadioGroup>

        <!-- 能力检测提示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/capRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/success"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/capShizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/success"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:text="@string/ob_start"
            android:textColor="@color/bg"
            android:textSize="16sp"
            android:backgroundTint="@color/accent" />
    </app.dsh.mobile.MaxWidthLinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- 主题设置（v1.6.x）：完全按 Material 3 官方做法。
     参考 docs/md3/README.md 与 dynamic-colors 官方文档。

     页面只有两组，全部原生组件：
       1. 外观模式：MaterialRadioButton 单选（浅色/深色/跟随系统）
       2. 配色方案：系统动态取色或预设色板（ThemePaletteSelector 运行时注入）

     注意：v1.6.x 起不再提供 Classic / Material 风格切换（cardStyle /
     groupStyle / btnStyleClassic / btnStyleMaterial / subStyle 已移除）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/theme_page_title"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/md3_page_padding"
            android:paddingBottom="@dimen/md3_page_bottom">

            <!-- ===== 外观模式 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md3_card_gap_first"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/theme_mode_section"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="?attr/dshCardRadius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dshStroke"
                app:strokeWidth="?attr/dshCardStroke"
                app:cardBackgroundColor="?attr/dshSurface">

                <RadioGroup
                    android:id="@+id/appearanceModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbModeLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="start|center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:minHeight="@dimen/md3_item_two_line"
                        android:paddingStart="8dp"
                        android:paddingEnd="@dimen/md3_item_padding_h"
                        android:paddingVertical="12dp"
                        android:saveEnabled="false"
                        android:singleLine="false"
                        android:textAllCaps="false"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:dividerInsetStart="@dimen/md3_divider_inset"
                        app:dividerInsetEnd="0dp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbModeDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="start|center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:minHeight="@dimen/md3_item_two_line"
                        android:paddingStart="8dp"
                        android:paddingEnd="@dimen/md3_item_padding_h"
                        android:paddingVertical="12dp"
                        android:saveEnabled="false"
                        android:singleLine="false"
                        android:textAllCaps="false"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        app:dividerInsetStart="@dimen/md3_divider_inset"
                        app:dividerInsetEnd="0dp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbModeSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="start|center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:minHeight="@dimen/md3_item_two_line"
                        android:paddingStart="8dp"
                        android:paddingEnd="@dimen/md3_item_padding_h"
                        android:paddingVertical="12dp"
                        android:saveEnabled="false"
                        android:singleLine="false"
                        android:textAllCaps="false"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 配色方案 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/theme_color_section"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md3_card_gap"
                app:cardCornerRadius="?attr/dshCardRadius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dshStroke"
                app:strokeWidth="?attr/dshCardStroke"
                app:cardBackgroundColor="?attr/dshSurface">

                <LinearLayout
                    android:id="@+id/paletteContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="16dp" />
            </com.google.android.material.card.MaterialCardView>
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>

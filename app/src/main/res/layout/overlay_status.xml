<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 状态悬浮窗（v1.2.58 初版，v1.2.65 三段式重做）

  三段形态（点一下升一档）：
    ① 折叠态  —— 只有一个**圆形半透明状态点**，尽量不挡视线
    ② 展开态  —— 状态点 + 状态文字（空闲/执行中）+ 麦克风按钮
    ③ 详情态  —— 在②基础上追加：最近动作 + 活跃会话列表（名称/最后活跃时间）

  颜色语义与设置页一致：强调蓝=执行中 / 绿=完成 / 灰=空闲 / 红=录音中。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:minWidth="0dp"
    android:elevation="8dp">

    <!-- 状态行：圆点 + 主文案 + 麦克风（折叠态只显示圆点，其余由代码控制可见性） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 状态点：两种形态同尺寸 14dp（DOT_DP，见 StatusOverlay）——
             10dp 在展开态偏小、与折叠态切换时大小跳动 -->
        <View
            android:id="@+id/overlayDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_overlay_dot" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:textColor="#FFE8EAED"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="DSH" />

        <!-- 语音输入按钮：点击开始/停止录音识别 -->
        <ImageView
            android:id="@+id/overlayMic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:padding="3dp"
            android:src="@drawable/ic_mic"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_voice_input"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 动作行：展开态可见（AI 最近在做什么） -->
    <TextView
        android:id="@+id/overlayAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="#FF9AA0A6"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <!-- 详情态：活跃会话列表（容器由代码填充，避免 XML 写死条目数） -->
    <LinearLayout
        android:id="@+id/overlaySessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:visibility="gone" />
</LinearLayout>

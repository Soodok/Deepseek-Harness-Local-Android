<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md3_bg">

    <!-- MD3 顶栏：大标题 + borderless 返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/md3_topbar_icon"
            android:layout_height="@dimen/md3_topbar_icon"
            android:layout_marginStart="4dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:id="@+id/settingsContentWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/md3_page_padding"
            android:paddingBottom="@dimen/md3_page_bottom">

            <LinearLayout
                android:id="@+id/settingsColumns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/columnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/settings_section_personalization"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_single">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_theme"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_section_appearance"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/subAppearanceEntry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_section_appearance_sub"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/settings_section_appearance"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowExt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_top">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_package"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_ext"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/valExt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowLinux"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_mid">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_ext_android_tools"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/linux_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/subLinux"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_linux_sub"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/valLinux"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowExtensionVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_bottom">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_puzzle"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_section_voice_plugins"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/settings_section_permission"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowPermEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_top">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_key"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_group_engine"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowPermCaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_bottom">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_touch"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_perm_group_caps"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/columnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/settings_section_data"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowUserPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_top">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_note"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_user_prompt"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_user_prompt_sub"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_mid">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_restore"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_backup"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_backup_sub"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowFilesDir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_bottom">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_folder"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_files_dir"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/valFilesDir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:text="@string/settings_section_network"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowLanWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_top">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_lan"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_lan_web"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/lanWebSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_lan_web"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swLanWeb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowRuntimeProxy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_bottom">
                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:src="@drawable/ic_export"
                        android:contentDescription="@null"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/md3_item_gap"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_runtime_proxy"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/subRuntimeProxy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_runtime_proxy_sub"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

<?xml version="1.0" encoding="utf-8"?>
<!-- 云端语音识别设置（v1.2.74）：顶栏与扩展中心/ASR 模型页同款（56dp / ic_back / 20sp 粗体） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF101418">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/cloud_tts_title"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ttsState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:textSize="14sp"
            android:textColor="#FF8A94A3" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="10dp"
        android:textColor="#FF8A94A3"
        android:textSize="12sp"
        android:text="@string/cloud_tts_desc" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- API Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cloud_asr_key"
                android:textColor="#FF7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ttsEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:hint="@string/cloud_tts_endpoint_hint"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#FFE8EAED"
                android:textColorHint="#66FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/cloud_tts_hint"
                android:textColor="#FF8A94A3"
                android:textSize="11sp" />

            <!-- 接口地址 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/cloud_asr_endpoint"
                android:textColor="#FF7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ttsToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#FFE8EAED"
                android:textSize="13sp" />

            <!-- 模型 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/cloud_asr_model"
                android:textColor="#FF7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ttsVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#FFE8EAED"
                android:textSize="13sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/cloud_tts_rate"
                android:textColor="#FF7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ttsRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#FFE8EAED"
                android:textSize="13sp" />

            <!-- 保存 / 清除 / 试听 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/rowClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_voice_input"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_tts_clear"
                        android:textColor="#FF9AA0A6"
                        android:textSize="13sp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/rowSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_voice_input"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_asr_save"
                        android:textColor="#FF7DD3FC"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/rowTest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_accent"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_tts_clear"
                        android:textColor="#FF0B1116"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

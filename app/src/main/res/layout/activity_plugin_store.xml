<?xml version="1.0" encoding="utf-8"?>
<!-- 社区插件中心（v1.2.117）：实时 npm 搜索 + 一键安装。
     结构与扩展中心一致（顶栏 + ScrollView），保证可滚动、风格统一。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部栏：返回箭头 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/plugin_center_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- v1.4.27：应急总开关生效期间的常驻提示。点一下直接恢复（不弹二次确认：
         文案本身已经写清动作，且此时用户多半正被坏插件卡着，越少点击越好）。 -->
    <TextView
        android:id="@+id/tvKillBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/plugin_kill_banner"
        android:textColor="@color/warning"
        android:textSize="12sp"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone" />

    <!-- v1.4.21：双标签（市场 / 已安装）+ 排序 + 检查更新。
         参考 DSHA 的插件中心形态。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnTabMarket"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/plugin_tab_market"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnTabInstalled"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/plugin_tab_installed"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/plugin_sort_title"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCheckUpdates"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/plugin_check_updates"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- v1.4.18：平板横屏下限宽居中（搜索行 + 副标题 + 列表一起收窄） -->
    <app.dsh.mobile.MaxWidthLinearLayout
        android:id="@+id/pluginStoreBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

    <!-- 搜索行（v1.2.118 极简）：图标集成在输入框内，无独立按钮 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="@string/plugin_search_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:background="@drawable/bg_search_field" />

        <!-- 左侧放大镜（纯装饰，不接收点击） -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_search"
            android:alpha="0.5"
            android:importantForAccessibility="no" />

        <!-- 右侧清除（有输入时才显示） -->
        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:alpha="0.5"
            android:visibility="gone"
            android:contentDescription="@string/plugin_search_clear" />
    </FrameLayout>

    <!-- v1.4.24：分类筛选（dsh-market 目录的 23 个分类，横向滚动） -->
    <HorizontalScrollView
        android:id="@+id/categoryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/categoryChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 结果列表（可滚动）。id 供增量渲染监听「滚到底 → 继续追加」。 -->
    <ScrollView
        android:id="@+id/listScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp" />
    </ScrollView>
    </app.dsh.mobile.MaxWidthLinearLayout>
</LinearLayout>

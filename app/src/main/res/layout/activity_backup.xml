<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

        <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/setting_backup"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/md3_page_padding"
            android:paddingBottom="@dimen/md3_page_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md3_card_gap_first"
                android:orientation="vertical">


<com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md3_card_gap"
                app:cardCornerRadius="@dimen/md3_card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
<LinearLayout
                    android:id="@+id/rowExportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                    android:layout_width="@dimen/md3_icon_chip"
                    android:layout_height="@dimen/md3_icon_chip"
                    android:padding="9dp"
                    android:src="@drawable/ic_export"
                    android:background="@drawable/bg_md3_icon_chip"
                    android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_export_data"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                    android:id="@+id/txtExportSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_export_data_sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="2dp" />
                    </LinearLayout>
                    </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerInsetStart="@dimen/md3_divider_inset"
                    app:dividerInsetEnd="0dp" />
<LinearLayout
                    android:id="@+id/rowImportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:padding="9dp"
                        android:src="@drawable/ic_restore"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_import_data"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/txtImportSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_import_data_sub"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerInsetStart="@dimen/md3_divider_inset"
                    app:dividerInsetEnd="0dp" />
<LinearLayout
                    android:id="@+id/rowRecoverChats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                    android:layout_width="@dimen/md3_icon_chip"
                    android:layout_height="@dimen/md3_icon_chip"
                    android:padding="9dp"
                    android:src="@drawable/ic_restore"
                    android:background="@drawable/bg_md3_icon_chip"
                    android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_recover_chats"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                    android:id="@+id/txtRecoverSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_recover_chats_sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="2dp" />
                    </LinearLayout>
                    </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerInsetStart="@dimen/md3_divider_inset"
                    app:dividerInsetEnd="0dp" />
<LinearLayout
                    android:id="@+id/rowConfigFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:padding="9dp"
                        android:src="@drawable/ic_log"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_config_files"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_config_files_sub"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md3_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/md3_topbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md3_surface"
        android:elevation="0dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/md3_topbar_icon"
            android:layout_height="@dimen/md3_topbar_icon"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back"
            android:tint="@color/md3_on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/setting_backup"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/md3_page_padding"
            android:paddingBottom="@dimen/md3_page_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md3_card_gap_first"
                android:orientation="vertical">


<LinearLayout
                    android:id="@+id/rowExportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_top">

                    <ImageView
                    android:layout_width="@dimen/md3_icon_chip"
                    android:layout_height="@dimen/md3_icon_chip"
                    android:padding="9dp"
                    android:src="@drawable/ic_export"
                    android:background="@drawable/bg_md3_icon_chip"
                    android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_export_data"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                    android:id="@+id/txtExportSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_export_data_sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="2dp" />
                    </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="2dp" />

<LinearLayout
                    android:id="@+id/rowImportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_mid">

                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:padding="9dp"
                        android:src="@drawable/ic_restore"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_import_data"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/txtImportSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_import_data_sub"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="2dp" />

<LinearLayout
                    android:id="@+id/rowRecoverChats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_mid">

                    <ImageView
                    android:layout_width="@dimen/md3_icon_chip"
                    android:layout_height="@dimen/md3_icon_chip"
                    android:padding="9dp"
                    android:src="@drawable/ic_restore"
                    android:background="@drawable/bg_md3_icon_chip"
                    android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_recover_chats"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                    android:id="@+id/txtRecoverSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_recover_chats_sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="2dp" />
                    </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="2dp" />

<LinearLayout
                    android:id="@+id/rowConfigFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/md3_item_padding_h"
                    android:minHeight="@dimen/md3_item_two_line"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_md3_seg_bottom">

                    <ImageView
                        android:layout_width="@dimen/md3_icon_chip"
                        android:layout_height="@dimen/md3_icon_chip"
                        android:padding="9dp"
                        android:src="@drawable/ic_log"
                        android:background="@drawable/bg_md3_icon_chip"
                        android:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_config_files"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_config_files_sub"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                </LinearLayout>
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>

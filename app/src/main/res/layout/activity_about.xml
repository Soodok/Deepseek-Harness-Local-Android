<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground">
        <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/about_title"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:titleTextColor="?attr/colorOnSurface" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <app.dsh.mobile.MaxWidthLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="32dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/md3_card_gap" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface" app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:layout_marginTop="8dp">
                    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_launcher" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_app_name" android:textColor="?attr/colorOnSurface" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="12dp" />
                    <TextView android:id="@+id/txtVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/txtForkBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_fork_badge" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/md3_card_gap" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface" app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_intro" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" android:lineSpacingExtra="4dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_based" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:layout_marginTop="10dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_author" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="28dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/rowRepo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:layout_marginTop="14dp" android:background="?attr/colorSurfaceContainer" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_open_source" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                    <TextView android:id="@+id/txtRepo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="13sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowStar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="16dp" android:layout_marginTop="14dp" android:background="@drawable/bg_star_promo" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_star_white" android:contentDescription="@string/about_star_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_star_title" android:textColor="?attr/colorOnPrimary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_star_sub" android:textColor="?attr/colorOnPrimary" android:textSize="12sp" android:layout_marginTop="3dp" android:lineSpacingExtra="2dp" />
                </LinearLayout>
                <TextView android:id="@+id/txtStarAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_star_action" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="@string/about_star_action" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowQqGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:layout_marginTop="14dp" android:background="?attr/colorSurfaceContainer" android:clickable="true" android:focusable="true">
                 <ImageView android:id="@+id/imgQqGroupAvatar" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:src="@drawable/qq_group_avatar" android:scaleType="centerCrop" android:background="@drawable/bg_md3_icon_chip" android:clipToOutline="true" android:contentDescription="@string/about_qq_group" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_qq_group" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_qq_group_id" android:textColor="@color/accent" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:text="@string/about_qq_group_tap" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowTelegram" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:layout_marginTop="14dp" android:background="?attr/colorSurfaceContainer" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_telegram" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_telegram_sub" android:textColor="@color/accent" android:textSize="13sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:text="@string/about_telegram_open" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
            </LinearLayout>
            <!-- 致谢者（v1.6.0）：名单由 AboutActivity 从 RepoCredits 填，
                 不把几十条文案写死在布局里 -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/about_credits" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtCredits" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:lineSpacingExtra="3dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/about_repos" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/reposBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="?attr/colorSurfaceContainer" android:padding="16dp" android:text="@string/about_privacy_note" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:lineSpacingExtra="3dp" />
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>

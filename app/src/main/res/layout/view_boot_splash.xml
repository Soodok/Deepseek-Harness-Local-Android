<?xml version="1.0" encoding="utf-8"?>
<!--
  启动遮罩（v1.6.19 重做）。

  与旧版的三处结构性差别：
    1. **没有居中卡片**。旧的 340dp 白/深圆角卡片是「一块板」，在这种
       全屏等待场景里显得廉价；现在内容直接落在背景上，靠细环与留白成层次。
    2. **进度环成为视觉主体**，鲸鱼压在环心 —— 不再需要图标底衬。
    3. 步骤区与正文在同一个滚动容器里，避免嵌套滚动与「展开后卡片破洞」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:elevation="30dp"
    android:visibility="invisible">

    <ScrollView
        android:id="@+id/splashScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/splashBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="72dp"
                android:paddingBottom="32dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/splashRing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="0dp"
                        android:indeterminate="true"
                        android:max="10000"
                        app:indicatorSize="144dp"
                        app:indicatorInset="4dp"
                        app:trackThickness="4dp"
                        app:trackColor="?attr/colorPrimaryContainer"
                        android:contentDescription="@string/splash_starting" />

                    <ImageView
                        android:id="@+id/splashLogo"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_launcher_foreground"
                        android:scaleType="fitCenter"
                        android:tint="?attr/colorOnSurface"
                        android:contentDescription="@string/app_name"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:text="@string/splash_tagline"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/splashModeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <View
                        android:id="@+id/splashModeDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/splash_mode_dot"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/splashModeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/splash_mode_detecting"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/splashModeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/splash_ui_mode_waiting"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="44dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/splashStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:text="@string/splash_preparing"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="3dp"
                        android:accessibilityLiveRegion="polite" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/splashElapsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/splashPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/splashDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:layout_marginTop="10dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="?attr/colorOutlineVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/splashToggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="6dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:text="@string/splash_show_steps"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <LinearLayout
                        android:id="@+id/splashStepsPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/splashSteps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            android:paddingBottom="16dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="5dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>

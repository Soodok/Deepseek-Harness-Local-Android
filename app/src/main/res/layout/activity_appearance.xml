<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md3_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/md3_topbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md3_surface"
        android:elevation="0dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/settings_section_appearance"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/md3_page_padding"
            android:paddingBottom="@dimen/md3_page_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/md3_card_gap_first">

<LinearLayout
                android:id="@+id/rowTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_top">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_theme"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_theme"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_theme_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                android:id="@+id/valTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout><View android:layout_width="match_parent" android:layout_height="2dp" /><LinearLayout
                android:id="@+id/rowAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_mid">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_palette"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_accent"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_accent_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                android:id="@+id/valAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout><View android:layout_width="match_parent" android:layout_height="2dp" /><LinearLayout
                android:id="@+id/rowSettingsBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_mid">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_display"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_settings_bg_page"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_settings_bg_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- 背景图预览缩略图：有图时显示，无图时隐藏 -->
                <ImageView
                android:id="@+id/imgSettingsBgPreview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_md3_icon_chip"
                android:visibility="gone" />

                <TextView
                android:id="@+id/valSettingsBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout><View android:layout_width="match_parent" android:layout_height="2dp" /><LinearLayout
                android:id="@+id/rowLayoutMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_mid">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_layout"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_layout_mode"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_layout_mode_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                android:id="@+id/valLayoutMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout><LinearLayout
                android:id="@+id/rowIslandDotImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_bottom">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_status_bar"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_status_bar"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_status_bar_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </LinearLayout>
<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/md3_card_gap">

<LinearLayout
                android:id="@+id/rowLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_top">

                <ImageView
                android:id="@+id/iconLandscape"
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_rotate"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:id="@+id/lblLandscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_landscape"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

                <TextView
                android:id="@+id/subLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_landscape_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                android:id="@+id/valLandscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_orient_portrait"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout><View android:layout_width="match_parent" android:layout_height="2dp" />

                <!-- 设置页跟随屏幕方向（v1.5.x）：默认关 = 手机锁竖屏、平板跟随偏好 --><LinearLayout
                android:id="@+id/rowSettingsFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_mid">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_rotate"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_follow_orientation"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

                <TextView
                android:id="@+id/subSettingsFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_follow_orientation_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSettingsFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
                </LinearLayout><View android:layout_width="match_parent" android:layout_height="2dp" /><LinearLayout
                android:id="@+id/rowImmersive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_mid">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_display"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_immersive"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_immersive_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swImmersive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
                </LinearLayout><View android:layout_width="match_parent" android:layout_height="2dp" />

                <!-- 官方推荐手机 UI（v1.4.67）：两套竖屏布局方案二选一 --><LinearLayout
                android:id="@+id/rowScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_bottom">

                <ImageView
                android:id="@+id/iconScale"
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_scale"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_scale"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_scale_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                android:id="@+id/valScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

                <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </LinearLayout>
<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/md3_card_gap">

<LinearLayout
                android:id="@+id/rowOfficialUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:minHeight="@dimen/md3_item_two_line"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/md3_item_padding_h"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_md3_seg_single">

                <ImageView
                android:layout_width="@dimen/md3_icon_chip"
                android:layout_height="@dimen/md3_icon_chip"
                android:padding="9dp"
                android:src="@drawable/ic_display"
                android:background="@drawable/bg_md3_icon_chip"
                app:tint="?attr/colorOnSurface" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_official_ui"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

                <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_official_ui_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swOfficialUi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>
</app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>

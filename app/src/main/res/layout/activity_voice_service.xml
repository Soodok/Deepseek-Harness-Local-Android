<?xml version="1.0" encoding="utf-8"?>
<!-- 语音服务（v1.2.78）：识别 + 合成合并成一页，入口在扩展中心。
     顶栏与扩展中心/其它子页同款（56dp / ic_back / 20sp 粗体） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

        <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/voice_service_title"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">

        <!-- v1.4.18：平板横屏下限宽居中 -->
        <app.dsh.mobile.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- ============ 语音识别 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/voice_service_asr"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/voice_service_asr_desc"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- 识别通道为互斥选择，使用官方 Material 3 单选按钮组。 -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/asrModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segLocal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/asr_mode_local" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segApi"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/asr_mode_api" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/localPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 本地识别的四步（v1.5.9）：照着走就能配好，不用猜 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorSurfaceContainer"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/asr_steps_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/asr_step_1" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/asr_step_2" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/asr_step_3" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/asr_step_4" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnAsrRepo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/asr_repo_open"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:background="@drawable/bg_voice_input" />
            </LinearLayout>


            <!-- ===== 本地识别状态卡（v1.5.7）=====
                 原来「本地识别」藏在帮助弹窗 → 识别应用页 → 再跳 ASR App，
                 用户要跨两个 App、三次跳转才能配好，回来还得自己把引擎改成
                 「系统识别」。这里把状态与四个动作直接摆出来。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorSurfaceContainer"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/asr_local_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/asrLocalState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/asr_local_state_checking"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/asrLocalDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/asr_local_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAsrInstall"
                        style="@style/VoiceChip"
                        android:text="@string/asr_local_install" />

                    <TextView
                        android:id="@+id/btnAsrOpenConfig"
                        style="@style/VoiceChip"
                        android:layout_marginStart="8dp"
                        android:text="@string/asr_local_configure" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAsrSetDefault"
                        style="@style/VoiceChip"
                        android:text="@string/asr_local_set_default" />

                    <TextView
                        android:id="@+id/btnAsrSelfCheck"
                        style="@style/VoiceChip"
                        android:layout_marginStart="8dp"
                        android:text="@string/asr_local_self_check" />
                </LinearLayout>
            </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/apiPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 识别引擎（v1.2.87）：直接指定用哪个识别服务，
                 绕过被 ROM 重定向、打不开的系统「语音输入」设置页 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/asr_engine_label"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/asrEngineSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:popupTheme="@style/Theme.Dsh.Spinner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/asr_engine_hint"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <!-- 自用 API 标题 + 问号说明（主人要求：服务商由用户自己选） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_asr_custom"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- 很小的问号按钮：说明为什么配、能选哪些服务商 -->
                <TextView
                    android:id="@+id/btnAsrHelp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_md3_icon_chip"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cloud_asr_key"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/cloud_asr_key_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/asrKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textVisiblePassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/cloud_asr_free_hint"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/cloud_asr_endpoint"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/cloud_asr_endpoint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/asrEndpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/cloud_asr_model"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/cloud_asr_model">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/asrModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- ============ 语音合成 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/voice_service_tts"
                android:textColor="@color/success"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/voice_service_tts_desc"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/ttsOn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voice_tts_on"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/ttsOff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voice_tts_off"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cloud_tts_voice"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/ttsVoiceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:popupTheme="@style/Theme.Dsh.Spinner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/cloud_tts_rate"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/ttsRateSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_voice_input"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:popupTheme="@style/Theme.Dsh.Spinner" />

            <!-- 保存 / 试听 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/rowTestTts"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="104dp"
                    android:gravity="center"
                    android:background="@drawable/bg_voice_input"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_tts_test"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/rowSave"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="104dp"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_asr_save"
                        android:textColor="@color/on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </app.dsh.mobile.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>

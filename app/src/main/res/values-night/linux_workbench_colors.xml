<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 页面底与其他页面共用 bg；顶部是 bg 与 surface 的中间阶，保持受光且不吞掉卡面层次。 -->
    <color name="wb_bg">@color/bg</color>
    <color name="wb_bg_top">#FF131820</color>
    <!-- 卡面复用全局 surface / surface_alt：换回蓝调石板灰，保留上亮下暗的双层板。 -->
    <color name="wb_surface">@color/surface</color>
    <color name="wb_surface_hi">@color/surface_alt</color>
    <!-- 全局 stroke 为 #26FFFFFF；分别预合成到 surface / surface_alt，保留同一套线色强度。
         必须用不透明结果：色板 blend() 只混 RGB，直接引用半透明白会把主卡描边混成亮白。 -->
    <color name="wb_stroke">#FF383E48</color>
    <color name="wb_stroke_hi">#FF3C434E</color>
    <color name="wb_text">@color/text_primary</color>
    <color name="wb_text_secondary">@color/text_secondary</color>
    <!-- 全局深色语义色较亮，继续由色板选择深墨字，避免白字落在亮色实心按钮上。 -->
    <color name="wb_ink">#FF14171A</color>
    <!-- 与浅色同源的静态语义令牌；绿 / 黄 / 红不参与 AccentTint 的主题重染。 -->
    <color name="wb_accent_linux">@color/success</color>
    <color name="wb_accent_native">@color/warning</color>
    <color name="wb_idle">@color/text_muted</color>
    <color name="wb_fault">@color/danger</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dsh" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Dsh.Dialog</item>
        <!-- v1.4.43：允许窗口画进挖孔区。全屏时真正的沉浸式需要它，
             否则系统会在顶部保留一条与挖孔等高的黑边。
             shortEdges 在显示状态栏时无副作用（状态栏本身会占位）。 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Dsh.Spinner" parent="android:Theme.Material.NoActionBar">
        <item name="android:popupBackground">@drawable/bg_menu_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.Dsh.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Linux 工作台（方案 E）专用语义色。
     与全局 accent 分离：这里的绿/黄表达「容器引擎 / Bionic 原生」，
     不能随用户主题色重染（AccentTint 会重染 @color/accent 系）。 -->
<resources>
    <!-- 中性色复用全局石板灰，避免工作台的绿灰文字与其他页面色温分裂。 -->
    <!-- 页面底与全局 bg 同源；顶部向白色抬升半档，保留不随内容滚动的受光渐变。 -->
    <color name="wb_bg">@color/bg</color>
    <color name="wb_bg_top">#FFFAFBFD</color>
    <!-- 卡面上沿复用全局白色 surface，下沿保留微弱冷灰，避免把既有双层板变成平涂。 -->
    <color name="wb_surface">#FFFBFCFD</color>
    <color name="wb_surface_hi">@color/surface</color>
    <!-- 下沿用全局 stroke、上沿用较亮的 divider：统一线色，同时保留上亮下暗的描边。 -->
    <color name="wb_stroke">@color/stroke</color>
    <color name="wb_stroke_hi">@color/divider</color>
    <color name="wb_text">@color/text_primary</color>
    <color name="wb_text_secondary">@color/text_secondary</color>
    <!-- 亮语义色上的深墨保持不变，浅色实心按钮由色板按亮度选择白字。 -->
    <color name="wb_ink">#FF14171A</color>
    <!-- 绿 / 黄 / 红与全局静态状态色同源；不引用 accent，避免用户强调色覆盖引擎语义。 -->
    <color name="wb_accent_linux">@color/success</color>
    <color name="wb_accent_native">@color/warning</color>
    <color name="wb_idle">@color/text_muted</color>
    <color name="wb_fault">@color/danger</color>
</resources>

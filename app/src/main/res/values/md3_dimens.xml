<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 尺寸令牌（v1.5.x 设置界面重构）。
     所有设置页共用，不要在各页写死数值 —— 改一处全站生效。 -->
<resources>

    <!-- ===== 卡片 ===== -->
    <dimen name="md3_card_radius">20dp</dimen>
    <dimen name="md3_grid_cell_radius">16dp</dimen>   <!-- 网格格子（v1.6.1）：两列宽度下 20dp 显得圆过头，16dp 与 44dp 高相称 -->
    <dimen name="md3_card_gap">12dp</dimen>          <!-- 卡片之间 -->
    <dimen name="md3_card_gap_first">8dp</dimen>     <!-- 首张卡片距顶栏 -->

    <!-- ===== 页面 ===== -->
    <dimen name="md3_page_padding">16dp</dimen>      <!-- 内容左右留白 -->
    <dimen name="md3_page_bottom">32dp</dimen>

    <!-- ===== 顶栏 ===== -->
    <dimen name="md3_topbar_height">56dp</dimen>
    <dimen name="md3_topbar_icon">48dp</dimen>

    <!-- ===== 列表项 ===== -->
    <dimen name="md3_item_two_line">72dp</dimen>     <!-- 带副标题 -->
    <dimen name="md3_item_one_line">56dp</dimen>     <!-- 只有标题 -->
    <dimen name="md3_item_padding_h">16dp</dimen>
    <dimen name="md3_item_gap">16dp</dimen>          <!-- 图标与文字之间 -->
    <dimen name="md3_icon_chip">40dp</dimen>         <!-- leading icon 底圈 -->
    <dimen name="md3_icon_chip_radius">12dp</dimen>
    <dimen name="md3_icon_size">22dp</dimen>

    <!-- ===== 控件 ===== -->
    <dimen name="md3_button_height">48dp</dimen>
    <dimen name="md3_button_radius">20dp</dimen>
    <dimen name="md3_divider_inset">64dp</dimen>     <!-- 分隔线左侧缩进 = 16+40+16-8（v1.5.6：68→64，凑 8 的倍数） -->


    <!-- ===== 字号（v1.5.5 补充）=====
         之前这一族缺失，各页 textSize 写死（实测全 UI 71 处），
         于是「同一层级的标题在不同页面大小不一样」。
         命名沿用 md3_ 前缀，避免与后续新增的另一套 token 分叉。 -->
    <dimen name="md3_text_caption">11sp</dimen>      <!-- 次要说明 -->

    <!-- ===== 行内主操作按钮（v1.5.5）=====
         原按钮 65×48dp 实心高饱和，一屏 6~7 个抢走视觉重心。
         改为描边后按这里的高度/最小宽度统一，勿在代码里再写 dp()。 -->

    <!-- ===== 状态点（v1.5.5）===== -->

</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight 色板是关闭动态取色或系统不支持时的回退；Material 动态主题
         在 Activity 上覆盖这些语义角色，弹窗和菜单不得再用固定色覆盖它们。 -->
    <style name="Theme.Dsh" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_surface</item>
        <item name="colorSecondary">@color/accent_alt</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_surface</item>
        <item name="colorTertiary">@color/accent_alt</item>
        <item name="colorOnTertiary">@color/on_accent</item>

        <!-- 容器与文字使用同一组日夜资源，保持上游弹窗对比度修复。 -->
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md3_surface</item>
        <item name="colorSurfaceContainerLow">@color/md3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md3_surface_variant</item>
        <item name="colorSurfaceBright">@color/md3_surface</item>
        <item name="colorSurfaceDim">@color/md3_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <item name="colorOutlineVariant">@color/md3_outline_variant</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_accent</item>
        <item name="colorErrorContainer">@color/danger_soft</item>
        <item name="colorOnErrorContainer">@color/danger</item>

        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:alertDialogTheme">@style/Theme.Dsh.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Dsh.MaterialAlertDialog</item>
        <item name="dshBg">?attr/colorSurface</item>
        <item name="dshSurface">?attr/colorSurfaceContainer</item>
        <item name="dshSurfaceAlt">?attr/colorSurfaceContainerLow</item>
        <item name="dshSurfaceHigh">?attr/colorSurfaceContainerHigh</item>
        <item name="dshDialogBg">?attr/colorSurfaceContainerHigh</item>
        <item name="dshTextPrimary">?attr/colorOnSurface</item>
        <item name="dshTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="dshTextMuted">?attr/colorOnSurfaceVariant</item>
        <item name="dshAccent">?attr/colorPrimary</item>
        <item name="dshAccentSoft">?attr/colorPrimaryContainer</item>
        <item name="dshOnAccent">?attr/colorOnPrimary</item>
        <item name="dshDivider">?attr/colorOutlineVariant</item>
        <item name="dshStroke">?attr/colorOutlineVariant</item>
        <item name="dshDanger">?attr/colorError</item>
        <item name="dshSuccess">@color/success</item>
        <item name="dshWarning">@color/warning</item>
        <item name="dshIconColor">?attr/colorOnSurfaceVariant</item>
        <item name="dshBtnRipple">@color/btn_ripple</item>
        <item name="dshOverlay">@color/overlay</item>
        <item name="dshIslandText">?attr/colorOnSurfaceVariant</item>
        <item name="dshIslandAccent">?attr/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.Dsh.Style.Classic" parent="ThemeOverlay.Material3">
        <item name="dshBg">@color/bg</item>
        <item name="dshSurface">@color/surface</item>
        <item name="dshSurfaceAlt">@color/surface_alt</item>
        <item name="dshSurfaceHigh">@color/surface_high</item>
        <item name="dshDialogBg">@color/dialog_bg</item>
        <item name="dshTextPrimary">@color/text_primary</item>
        <item name="dshTextSecondary">@color/text_secondary</item>
        <item name="dshTextMuted">@color/text_muted</item>
        <item name="dshAccent">@color/accent</item>
        <item name="dshAccentSoft">@color/accent_soft</item>
        <item name="dshOnAccent">@color/on_accent</item>
        <item name="dshDivider">@color/divider</item>
        <item name="dshStroke">@color/stroke</item>
        <item name="dshDanger">@color/danger</item>
        <item name="dshSuccess">@color/success</item>
        <item name="dshWarning">@color/warning</item>
        <item name="dshIconColor">@color/icon_color</item>
        <item name="dshBtnRipple">@color/btn_ripple</item>
        <item name="dshOverlay">@color/overlay</item>
        <item name="dshIslandText">@color/island_text</item>
        <item name="dshIslandAccent">@color/island_accent</item>
    </style>

    <style name="ThemeOverlay.Dsh.Style.Material" parent="ThemeOverlay.Material3">
        <item name="dshBg">?attr/colorSurface</item>
        <item name="dshSurface">?attr/colorSurfaceContainer</item>
        <item name="dshSurfaceAlt">?attr/colorSurfaceContainerLow</item>
        <item name="dshSurfaceHigh">?attr/colorSurfaceContainerHigh</item>
        <item name="dshDialogBg">?attr/colorSurfaceContainerHigh</item>
        <item name="dshTextPrimary">?attr/colorOnSurface</item>
        <item name="dshTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="dshTextMuted">?attr/colorOnSurfaceVariant</item>
        <item name="dshAccent">?attr/colorPrimary</item>
        <item name="dshAccentSoft">?attr/colorPrimaryContainer</item>
        <item name="dshOnAccent">?attr/colorOnPrimary</item>
        <item name="dshDivider">?attr/colorOutlineVariant</item>
        <item name="dshStroke">?attr/colorOutlineVariant</item>
        <item name="dshDanger">?attr/colorError</item>
        <item name="dshSuccess">@color/success</item>
        <item name="dshWarning">@color/warning</item>
        <item name="dshIconColor">?attr/colorOnSurfaceVariant</item>
        <item name="dshBtnRipple">@color/btn_ripple</item>
        <item name="dshOverlay">@color/overlay</item>
        <item name="dshIslandText">?attr/colorOnSurfaceVariant</item>
        <item name="dshIslandAccent">?attr/colorPrimary</item>
    </style>

    <style name="Theme.Dsh.Spinner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:popupBackground">@drawable/bg_menu_card</item>
    </style>

    <!-- 平台 AlertDialog 和 MaterialAlertDialog 都继承当前主题角色，不固化颜色。 -->
    <style name="Theme.Dsh.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorAlertDialogListItem">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.Dsh.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Dsh</item>
    </style>

    <style name="MaterialAlertDialog.Dsh" parent="MaterialAlertDialog.Material3">
        <item name="singleChoiceItemLayout">@layout/dialog_single_choice</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- APK 型扩展（扩展中心）触发系统安装器（v1.2.127，如 dsh-asr-service） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 要求前台服务声明类型；specialUse 类型不会被系统限时强杀（dataSync 6h 上限的规避） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 资源包后台下载用 dataSync 前台服务（v1.4.x） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知为运行时权限，任务进度通知需要 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 语音输入（v1.2.58）：ASR 需要麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- issue #72：WebView 的音频采集除 RECORD_AUDIO 外**还要求**本权限。
         缺它时 Chromium 直接判定「没有可用的录音设备」：
           cr_media: Requires MODIFY_AUDIO_SETTINGS and RECORD_AUDIO.
                     No audio device will be available for recording
         表现与权限被拒几乎一样（getUserMedia 失败），极难定位 —— 实测踩过。
         这是普通权限，安装即授予，不会弹框。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 语音输入开/关的触感反馈（v1.2.73）：无此权限时 Vibrator 调用被静默忽略 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.2.161：验证码提示条用普通浮层通道（无障碍不在位时也能显示） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 所有文件访问：普通模式下授权 AI 在共享存储（/sdcard）建目录与读写 ——
         权限中心跳系统设置授予（isExternalStorageManager），引擎进程与 App 同 uid 继承 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- v1.4.17（issue #37）：blob 下载落盘到公共 Download/ 在 Android 8/9 上需要
         运行时存储权限（Android 10+ 走 MediaStore 无需权限）。仅按 maxSdk 声明，
         不影响 Android 10+ 的权限模型。配套 requestLegacyExternalStorage：
         Android 10 上 targetSdk 28 直接按路径写 /sdcard/Download 需要 legacy 标记。
         v1.4.20（issue #42）：maxSdk 提到 29 —— Android 10（API 29）引入 scoped
         storage 但 targetSdk≤28 的应用在 requestLegacyExternalStorage 下仍是
         路径模型，WRITE 权限真实生效；28 封顶会让 API 29 设备「既无权限也无
         授权入口」（MANAGE_EXTERNAL_STORAGE 是 API 30 才有的）。API 30+ 用
         MANAGE_EXTERNAL_STORAGE，不受影响。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- ⚠️ Android 11+ 的 package visibility（v1.2.83，调研发现的关键坑）：
         不声明 <queries> 时，App **看不到**用户后来安装的语音识别服务，
         SpeechRecognizer.isRecognitionAvailable() 会返回 false ——
         这正是「装了本地识别应用却依然用不了」的根因。
         声明后系统才会把符合该 intent 的服务暴露给本应用。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 语音合成引擎同理（系统 TTS 枚举） -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- ⚠️ 包名可见性（v1.2.87 修复）：上面两个 <intent> 只让**枚举**可见，
             但「指定组件绑定」（createSpeechRecognizer(ctx, component)）与
             queryIntentServices(带 setComponent) 需要**包名级**可见性。
             缺它会表现为：语音服务页选不到插件、指定了也不生效。 -->
        <package android:name="app.dsh.asr" />
    </queries>

    <application
        android:name=".DshApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Dsh"
        android:allowBackup="false" android:requestLegacyExternalStorage="true">

        <!-- v1.2.188：局域网 WebUI「已开启」常驻通知里的关闭按钮。
             exported=false：只接受本应用 PendingIntent 发出的广播，
             不暴露给其它应用。 -->
        <receiver
            android:name=".LanWebOffReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.dsh.mobile.action.LAN_WEB_OFF" />
            </intent-filter>
        </receiver>

        <!-- v1.4.46：windowSoftInputMode 必须显式 adjustResize ——
             全屏（decorFitsSystemWindows=false）时系统不再自动为 IME 让位，
             缺它会让键盘完全盖住 WebUI 对话框的输入框（用户实测）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扩展包装包走统一 ApkInstaller + InstallResultReceiver（KIND_EXTENSION），
             不需要上游的 ExtensionApkInstallActivity 专用回调，故不注册。 -->

        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".PluginStoreActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 用户自定义指令（v1.3.2，issue #19）：编辑 AGENTS.md 的用户段，App 永不覆盖 -->
        <activity
            android:name=".UserPromptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 维护与高级（v1.4.45）：诊断与高风险操作子页，从设置主页收拢 -->
        <activity
            android:name=".MaintenanceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 应用更新（v1.4.46）：低频更新配置子页，从设置主页收拢 -->
        <activity
            android:name=".UpdateSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 备份与恢复（v1.4.46）：低频数据操作子页，从设置主页收拢 -->
        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 应用内文件编辑页（v1.4.0，issue #25）：上游「打开配置文件」在 Android
             没有可用的桌面编辑器（macOS open -t / Windows 资源管理器 / Linux
             xdg-open 三者皆无），引擎把这请求转到本页。见 FileEditorActivity 注释。
             不让系统重建 Activity：编辑到一半转屏或切输入法丢内容不可接受。
             exported=false：只有本应用（AgentBridge）能拉起。 -->
        <activity
            android:name=".FileEditorActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <!-- 扩展中心（v1.2.0）：环境扩展下载/激活管理 -->
        <activity
            android:name=".ExtensionStoreActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- ASR 模型管理页（v1.2.64）：离线语音识别模型下载/加载。
             此前漏注册 —— 设置页点击必崩 ActivityNotFoundException（模拟器实测确认）。 -->
        <activity
            android:name=".AsrAppActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".VoiceServiceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 日志查看器（engine.log / boot.log 尾部） -->
        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <!-- 真 PTY 终端（对齐 DSHA 的 PtyTerminalFragment）：Termux TerminalView +
             自带 bash。exported=false：只由本应用拉起。adjustResize 让软键盘顶起终端。 -->
        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <service
            android:name=".service.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_ai_agent_engine" />
        </service>

        <!-- 桌宠悬浮窗（预留，用户安装 dsh-pet-bridge 后自行开启）：
             独立于无障碍状态球，使用 TYPE_APPLICATION_OVERLAY，需要用户授予
             SYSTEM_ALERT_WINDOW；前台服务类型 specialUse，避免被系统限时。 -->
        <service
            android:name=".pet.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_desktop_pet" />
        </service>

        <!-- 资源包后台下载：独立前台服务，用户退出设置页后任务照跑，
             进度走通知栏；dataSync 是这类"纯网络搬运"的标准类型。 -->
        <service
            android:name=".pet.PetPackDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 应用自动更新（v1.4.37）：APK 下载与运行时换装各一个前台服务。
             为什么必须是服务而不是 Activity 里的线程：几百 MB 的下载 + 3 分钟解压，
             用户不会一直停在界面上；Activity 销毁后任务不能跟着死。
             两者与安装共用 UpdateTasks 闸门，互斥执行（都要停引擎）。 -->
        <service
            android:name=".update.AppUpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".update.RuntimeUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 系统安装器回执。必须解 STATUS_PENDING_USER_ACTION（弹确认框）与
             SUCCESS / FAILURE_*，否则用户点了安装会"没有任何反应"。
             exported=false：只有系统（通过 PackageInstaller 的 IntentSender）能发到它。 -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.dsh.mobile.update.INSTALL_RESULT" />
            </intent-filter>
        </receiver>


        <activity
            android:name=".pet.PetSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".pet.PetLinesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 无障碍服务（m1.30）：为 AI 提供模拟屏幕点击；需用户在系统设置开启，
             meta-data 指向 xml/dsh_accessibility_service.xml 声明能力 -->
        <service
            android:name=".DshAccessibilityService"
            android:exported="false"
            android:launchMode="singleInstance"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dsh_accessibility_service" />
        </service>

        <!-- Shizuku provider（官方要求）：应用启动时由 provider 触发与 Shizuku server 的 binder 握手，
             没有它 requestPermission/弹窗都不会发生 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL">
            <meta-data
                android:name="moe.shizuku.client.VERSION_CODE"
                android:value="13" />
        </provider>
        <!-- 日志/内部文件分享：把 filesDir 里打不开的日志文件复制到 cache 后，
             经 FileProvider 以 content:// 交给系统分享面板（微信/QQ/文件管理器等）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

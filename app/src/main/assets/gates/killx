#!/system/bin/sh
# [dsh-android] 自举到引擎 bash（/dev/tcp 是 bash 特性，toybox sh 不支持）。
# shebang 机制不传环境变量，故显式设 LD_LIBRARY_PATH 后 exec；
# _DSH_REEXEC 标记防止 exec "$0" 造成无限递归。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] killx: kill processes matched by command NAME (comm) only.
# usage: killx <pattern> [signal]
#
# 与 psx 同源：按 comm 匹配，绝不匹配完整命令行 —— agent 自己的
# `bash -c '... killx foo ...'` 命令行里含 pattern，按 cmdline 匹配会自杀。
#
# 安全约束（刻意保留）：
#   · 不杀 PID 1（init）与自身进程树
#   · 不杀引擎 node 进程（杀了就把宿主搞崩，用户会看到引擎重启）
#   · 不杀系统关键进程（system_server / zygote / surfaceflinger 等）
#   · 默认 SIGTERM；显式传 9 才用 SIGKILL
[ $# -ge 1 ] || { echo "usage: killx <pattern> [signal]" >&2; exit 2; }
pattern="$1"
sig="${2:-15}"
case "$sig" in 9|15|1|2) ;; *) echo "killx: signal must be 1/2/9/15" >&2; exit 2 ;; esac

self=$$
killed=0
for d in /proc/[0-9]*; do
  pid="${d#/proc/}"
  [ "$pid" = "1" ] && continue
  [ "$pid" = "$self" ] && continue
  comm=$(cat "$d/comm" 2>/dev/null) || continue
  case "$comm" in
    node|system_server|zygote|zygote64|surfaceflinger|init) continue ;;
  esac
  case "$comm" in
    *"$pattern"*)
      kill "-$sig" "$pid" 2>/dev/null && killed=$((killed+1))
      ;;
  esac
done
if [ "$killed" = 0 ]; then
  echo "killx: no process matched '$pattern'" >&2
  exit 1
fi
echo "killx: signalled $killed process(es) matching '$pattern'"
exit 0

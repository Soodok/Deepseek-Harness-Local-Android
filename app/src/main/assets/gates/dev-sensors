#!/system/bin/sh
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] dev-sensors: one-shot sensor read.
#   dev sensors [accel|gyro|light|proximity|step|magnet|pressure]
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"
if [ -z "$1" ]; then dsh_http GET /dev/sensors; else dsh_http GET "/dev/sensors?type=$1"; fi

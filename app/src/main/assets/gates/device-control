#!/system/bin/sh
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] device-control: switch hardware on/off.
# usage: device-control <json>
#   {"op":"torch","on":true|false}      {"op":"wifi","on":true|false}
#   {"op":"bt","on":true|false}         {"op":"volume","level":0..1}
#   {"op":"brightness","level":0..1}    {"op":"vibrate","ms":200}
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"
body="$*"
if [ -z "$body" ]; then body=$(cat); fi
[ -n "$body" ] || { echo 'usage: device-control <json>' >&2; exit 2; }
out=$(dsh_http POST /dev/control "$body")
rc=$?
printf '%s\n' "$out"
exit "$rc"

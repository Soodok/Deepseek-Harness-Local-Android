#!/system/bin/sh
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] dev-dialog: detect permission/consent dialogs and pick a safe button.
#   dev dialog scan             report only
#   dev dialog scan --auto      report + tap the safest candidate
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"
auto=false
for a in "$@"; do [ "$a" = "--auto" ] && auto=true; done
dsh_http POST /dev/dialog "{\"auto\":$auto}" || exit 2

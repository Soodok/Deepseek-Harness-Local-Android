#!/system/bin/sh
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] mcp: run the device MCP server (stdio JSON-RPC).
#
# usage: mcp            serve MCP on stdin/stdout (a client pipes JSON-RPC in)
#        mcp list       print the tool names derived from the endpoint catalog
#        mcp selftest   in-process round trip (framing / handshake / list)
#        mcp probe      one real bridge call, for debugging
#
# Why a gate script and not a bridge endpoint: the server must outlive a single
# HTTP request (a client keeps it open for the whole session), and it needs the
# engine's own token, which only the engine process has.
DIR=$(cd "$(dirname "$0")" && pwd)
# node 解析（v1.7.6 真机）：宿主（原生模式）用引擎自带的 bionic node；
# 容器（Linux 模式）里 bionic 二进制 exec 不了，必须换发行版的 /usr/bin/node。
# 按**存在性**在运行时选，不依赖环境变量（引擎给 MCP 子进程的 env 不可控）。
# ⚠️ 用 -f 而不是 -x：容器（Linux 模式）里 runner 只翻译 open/stat/exec 一族，
#    access(2) 没被翻译 → `test -x` 对**任何**路径都返回「不可执行」（真机实测：
#    连 rootfs 里的 /usr/bin/node 都判不可执行）。可执行位本身是有的，交给 exec 去验。
NODE="$DIR/node"
for _c in /usr/bin/node /usr/local/bin/node; do
  if [ -f "$_c" ]; then NODE="$_c"; break; fi
done
TOOLS=""
for cand in "${DSH_HOME:-}/tools" "$DIR/../../dsh-home/tools" "$DIR/../tools"; do
  if [ -f "$cand/mcp-device.mjs" ]; then TOOLS="$cand"; break; fi
done
if [ -z "$TOOLS" ]; then
  printf '{"ok":false,"error":"mcp-device.mjs not found; expected $DSH_HOME/tools/"}\n' >&2
  exit 1
fi
if [ ! -f "$NODE" ]; then
  # 诊断（v1.7.6）：真机上出现过「宿主明明有 node 却报不存在」，只报路径无法定位。
  # 把执行身份、cwd 与几个候选的实际可见性一并打到 stderr（引擎会收进 engine.log）。
  printf '[mcp] node check failed: NODE=%s uid=%s cwd=%s\n' \
    "$NODE" "$(id -u 2>/dev/null)" "$(pwd 2>/dev/null)" >&2
  for _c in /usr/bin/node /usr/local/bin/node "$DIR/node"; do
    if [ -f "$_c" ]; then printf '[mcp]   candidate file: %s\n' "$_c" >&2
    else printf '[mcp]   candidate absent: %s\n' "$_c" >&2; fi
  done
  printf '{"ok":false,"error":"node not found at %s"}\n' "$NODE" >&2
  exit 1
fi
case "${1:-serve}" in
  # Extra args after `serve` reach the server verbatim: the engine registers
  # this server with `serve --only screenshot` so the model gets one tool that
  # returns a real image block, not the whole 40-endpoint catalog.
  serve)    shift; exec "$NODE" "$TOOLS/mcp-device.mjs" "$@" ;;
  list)     shift; exec "$NODE" "$TOOLS/mcp-device.mjs" --list "$@" ;;
  selftest) exec "$NODE" "$TOOLS/mcp-device.mjs" --self-test ;;
  probe)    exec "$NODE" "$TOOLS/mcp-device.mjs" --probe ;;
  *)
    printf 'usage: mcp [serve [--only id,id]|list|selftest|probe]\n' >&2
    exit 2
    ;;
esac

#!/system/bin/sh
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] dev-phone: recent call log (needs READ_CALL_LOG).
#   dev phone [limit=N]
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"
if [ -z "$1" ]; then dsh_http GET /dev/calls; else dsh_http GET "/dev/calls?$*"; fi

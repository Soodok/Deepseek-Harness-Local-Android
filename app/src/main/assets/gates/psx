#!/system/bin/sh
# [dsh-android] 自举到引擎 bash（/dev/tcp 是 bash 特性，toybox sh 不支持）。
# shebang 机制不传环境变量，故显式设 LD_LIBRARY_PATH 后 exec；
# _DSH_REEXEC 标记防止 exec "$0" 造成无限递归。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] psx: list processes matched by command NAME (comm) only.
# usage: psx <pattern>
#
# 为什么按 comm 而非完整命令行匹配（种子明确警告过）：agent 自己常以
# `bash -c '... pkill -f pattern ...'` 形式执行，完整命令行里就含 pattern
# → `pkill -f` / `ps | grep <cmdline>` 会命中自己并自杀（SIGKILL / 无输出）。
# 按 comm（进程名，不含参数）匹配则不会。
#
# 实现用 /proc 直接读，不依赖 ps 的具体输出格式（toybox ps 与 procps 差异大）：
#   /proc/<pid>/comm 是内核维护的进程名（截断到 15 字符，与 ps -o comm 一致）
[ $# -ge 1 ] || { echo "usage: psx <pattern>" >&2; exit 2; }
pattern="$1"
self=$$
found=0
for d in /proc/[0-9]*; do
  pid="${d#/proc/}"
  [ "$pid" = "$self" ] && continue
  comm=$(cat "$d/comm" 2>/dev/null) || continue
  case "$comm" in
    *"$pattern"*)
      printf '%s %s\n' "$pid" "$comm"
      found=1
      ;;
  esac
done
[ "$found" = 1 ] || exit 1
exit 0

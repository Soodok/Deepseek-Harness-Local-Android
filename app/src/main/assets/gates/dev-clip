#!/system/bin/sh
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] dev-clip: clipboard read / write.
#   dev clip read
#   dev clip write <text>
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"
case "$1" in
  read)  dsh_http POST /dev/clipboard '{"op":"read"}' || exit 2 ;;
  write) shift
         [ -n "$1" ] || { echo "usage: dev clip write <text>" >&2; exit 64; }
         dsh_http POST /dev/clipboard "{\"op\":\"write\",\"text\":\"$(_dsh_json_escape "$*")\"}" || exit 2 ;;
  "")    dsh_http POST /dev/clipboard '{"op":"read"}' || exit 2 ;;
  *)     dsh_http POST /dev/clipboard "{\"op\":\"$(_dsh_json_escape "$1")\"}" || exit 2 ;;
esac
